{
  "name": "valaxy-blog",
  "version": "0.14.28",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run fuse && npm run build:ssg && npm run rss",
    "build:spa": "valaxy build",
    "build:ssg": "valaxy build --ssg",
    "dev": "valaxy",
    "rss": "valaxy rss",
    "serve": "vite preview",
    "fuse": "valaxy fuse",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@vueuse/core": "^13.5.0",
    "valaxy": "0.26.12",
    "valaxy-addon-bangumi": "^0.2.2",
    "valaxy-addon-components": "^0.1.0",
    "valaxy-theme-yun": "0.26.12"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.6.2",
    "typescript": "^5.8.2",
    "vite-plugin-pwa": "^1.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,json,css,scss,md,html}": "prettier --write"
  }
}
